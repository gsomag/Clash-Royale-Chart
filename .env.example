# ===== Clash Royale API =====
# トークン（developer.clashroyale.com で発行）
# 【推奨】RoyaleAPI プロキシ経由 = どこからでも使える:
#   キー作成時に許可IPを「45.79.218.79」にして発行し、CR_API_BASE はプロキシのままにする。
CR_API_TOKEN=

# プレイヤータグ（# 含む。dotenvのコメント扱いを避けるため必ずクォートで囲む）
PLAYER_TAG="#8LJ8PGQJQ"

# APIベースURL（既定: RoyaleAPI プロキシ）
#   プロキシ: https://proxy.royaleapi.dev/v1   ← 推奨
#   直接:     https://api.clashroyale.com/v1
CR_API_BASE=https://proxy.royaleapi.dev/v1

# ===== データベース =====
# ローカル開発では未設定でOK（自動で data/battles.db のSQLiteファイルを使う）。
# 本番(Vercel)では Turso の接続情報を環境変数に設定する:
# TURSO_DATABASE_URL=libsql://xxxx.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# ===== Cron（任意）=====
# Vercel の毎日Cronから /api/sync を保護したい場合に設定（Vercelが自動でこの値を付与）。
# CRON_SECRET=

# ローカルのバックエンドポート
PORT=3001
