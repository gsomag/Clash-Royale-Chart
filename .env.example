# Clash Royale API トークン（developer.clashroyale.com で発行）
#
# 【推奨・どこでも使える設定】RoyaleAPI プロキシ経由:
#   キー作成時に許可IPを「45.79.218.79」にして発行 → どのネットワークからでも使える。
#   その場合、下の CR_API_BASE は https://proxy.royaleapi.dev/v1 のままにする。
#
# 【代替】自分の公開IPに紐づけて直接叩く場合:
#   キー作成時に自分の公開IPを登録 → CR_API_BASE を https://api.clashroyale.com/v1 に変更。
#   IPが変わると 403 になるため作り直しが必要（非推奨）。
CR_API_TOKEN=

# あなたのプレイヤータグ（# 含む。dotenvのコメント扱いを避けるため必ずクォートで囲む）
PLAYER_TAG="#8LJ8PGQJQ"

# API ベースURL（既定: RoyaleAPI プロキシ = どこでも使える）
#   プロキシ:   https://proxy.royaleapi.dev/v1   ← 推奨
#   直接:       https://api.clashroyale.com/v1
CR_API_BASE=https://proxy.royaleapi.dev/v1

# バックエンドのポート
PORT=3001
